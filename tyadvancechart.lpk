      <Conditionals Value="if GetIDEValue(&apos;LAZ_FULLVERSION&apos;) &gt;= 4990000 then CustomOptions += &apos; -dTY_LCL_FROM_4_99&apos;;"/>
    </CompilerOptions>
    <Description Value="TTyAdvanceChart, a port of Apache ECharts 6.1 to TyControls: the same option JSON drives the series, components and interactions, drawn with BGRABitmap and styled by the TyControls themes. Requires the TyControls Run-Time Package.

Homepage: https://github.com/ACTom/TyAdvanceChart"/>
